# Application Environment ("development" | "production" | "test")
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:3000

# Authentication & Session Security (MUST be >= 32 random bytes in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Set ALLOW_DEMO_TOKENS=false in production deployments to disable demo-session-* personas
ALLOW_DEMO_TOKENS=true
EXPOSE_DEV_RESET_TOKEN=false

# Database & Cache Configuration
DATABASE_URL=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
DB_USER=
REDIS_HOST=
REDIS_PORT=6379
REDIS_URL=

# Rate Limiting & Upload Controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1200
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Transactional Email (SMTP) & Server-Side Integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@iba-suk.edu.pk
EMAIL_FROM_NAME=Sukkur IBA AlumniConnect
GEMINI_API_KEY=
LOG_LEVEL=info