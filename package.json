{
  "name": "alumni-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite client --config client/vite.config.ts\" \"tsx --tsconfig server/tsconfig.json server/src/index.ts\"",
    "dev:client": "vite client --config client/vite.config.ts",
    "dev:server": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "build": "tsc -p shared/tsconfig.json && tsc -p client/tsconfig.json && vite build client --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "build:client": "tsc -p client/tsconfig.json && vite build client --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "db:generate": "echo 'Using built-in datastore'",
    "db:push": "prisma db push --schema=server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/prisma/seed.ts",
    "db:studio": "prisma studio --schema=server/prisma/schema.prisma",
    "test": "vitest run --config server/vitest.config.ts",
    "test:client": "vitest run --root client",
    "test:server": "vitest run --config server/vitest.config.ts",
    "lint": "eslint client/src server/src shared/src --ext ts,tsx",
    "format": "prettier --write \"{client,server,shared}/src/**/*.{ts,tsx,css,md}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/d3-geo": "^3.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.2",
    "@types/three": "^0.160.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.32",
    "prettier": "^3.2.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.5",
    "@google/genai": "^2.30.0",
    "@headlessui/react": "^1.7.18",
