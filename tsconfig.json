{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@alumni-connect/shared/*": ["shared/src/*"],
      "@alumni-connect/client/*": ["client/src/*"],
      "@alumni-connect/server/*": ["server/src/*"],
      "@/*": ["./src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}